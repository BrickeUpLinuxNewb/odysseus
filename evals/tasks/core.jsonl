# Project Inari starter task set: 30 programmatically-checkable tasks.
# 10 routing / 10 extraction / 5 JSON-output / 5 closed QA.
# These are PLACEHOLDER-BUT-REAL tasks: they exercise the job shapes the
# system actually does (routing, extraction, structured output). Replace or
# extend them with prompts mined from real usage (`python -m evals mine`) as
# logs accumulate. Lint after any edit: `python -m evals run --tasks
# evals/tasks/core.jsonl --target selftest --label lint`
#
# -- routing (choice) ---------------------------------------------------------
{"id": "route-001", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Reply to Sarah's message about the Q3 invoice and ask when payment lands.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "email"}}
{"id": "route-002", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Why does my Python script throw KeyError when the key is clearly in the dict?", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "code"}}
{"id": "route-003", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Set up a meeting with Dan next Tuesday at 3pm about the rack layout.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "calendar"}}
{"id": "route-004", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "What are people saying about the new RX 7800 XT price drop this week?", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "search"}}
{"id": "route-005", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Jot this down: the garage keypad code changed to 4482.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "notes"}}
{"id": "route-006", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Draft a polite follow-up to the recruiter who hasn't answered in two weeks.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "email"}}
{"id": "route-007", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "This SQL query returns duplicate rows after the join — fix it.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "code"}}
{"id": "route-008", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Move my dentist appointment from Wednesday to Friday morning.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "calendar"}}
{"id": "route-009", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Find recent benchmark numbers for Qwen 7B at different quantization levels.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "search"}}
{"id": "route-010", "kind": "choice", "tags": ["routing"], "system": "You are a request router. Answer with exactly one word from: email, code, calendar, search, notes.", "prompt": "Remember that the router admin password rotated on the first of the month.", "expect": {"choices": ["email", "code", "calendar", "search", "notes"], "answer": "notes"}}
#
# -- extraction ---------------------------------------------------------------
{"id": "extract-001", "kind": "contains", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"The kickoff meeting has been moved to March 14, 2026, pending final approval from facilities.\"\n\nExtract the meeting date in YYYY-MM-DD format.", "expect": {"value": "2026-03-14"}}
{"id": "extract-002", "kind": "contains", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"For access issues contact devon.reyes@quantex.io or call the helpdesk after 9am.\"\n\nExtract the email address.", "expect": {"value": "devon.reyes@quantex.io"}}
{"id": "extract-003", "kind": "numeric", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"Invoice INV-2231 — subtotal $1,712.50, tax $137.00, total due $1,849.50 by end of month.\"\n\nWhat is the total amount due? Answer with only the number.", "expect": {"value": 1849.5, "tol": 0.01}}
{"id": "extract-004", "kind": "contains_all", "tags": ["extraction"], "system": "Answer with only the requested values, nothing else.", "prompt": "Text: \"Marcus Chen will hand the deployment runbook to Elena Vasquez before Friday's cutover.\"\n\nList the names of every person mentioned.", "expect": {"values": ["Marcus", "Elena"]}}
{"id": "extract-005", "kind": "contains", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"If the portal is down, the on-call line is 555-0142 (ask for tier two).\"\n\nExtract the phone number.", "expect": {"value": "555-0142"}}
{"id": "extract-006", "kind": "exact", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"The crashes stopped after we upgraded the agent from 2.6.9 to 2.7.1 on every node.\"\n\nWhich version fixed the crashes? Answer with only the version number.", "expect": {"value": "2.7.1"}}
{"id": "extract-007", "kind": "numeric", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Shopping list: milk, eggs, sourdough bread, ground coffee.\n\nHow many items are on the list? Answer with only the number.", "expect": {"value": 4, "tol": 0}}
{"id": "extract-008", "kind": "exact", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"Flight UA-2214 lands in Denver at 6:40pm before continuing on to Portland.\"\n\nIn which city does the flight land first? Answer with only the city name.", "expect": {"value": "Denver"}}
{"id": "extract-009", "kind": "exact", "tags": ["extraction"], "system": "Answer with only the requested value, nothing else.", "prompt": "Text: \"Your return was approved — reference ORD-88213 in any follow-up about the refund.\"\n\nExtract the order reference code.", "expect": {"value": "ORD-88213"}}
{"id": "extract-010", "kind": "choice", "tags": ["extraction"], "system": "Answer with exactly one word from: monday, tuesday, wednesday, thursday, friday, saturday, sunday.", "prompt": "Text: \"Grant applications must be submitted by end of day Thursday; late entries roll to next quarter.\"\n\nOn which day of the week is the deadline?", "expect": {"choices": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"], "answer": "thursday"}}
#
# -- structured JSON output ---------------------------------------------------
{"id": "json-001", "kind": "json", "tags": ["json", "routing"], "system": "Respond with ONLY a JSON object, no prose: {\"route\": one of \"email\"|\"code\"|\"calendar\"|\"search\"|\"notes\", \"confidence\": number between 0 and 1}", "prompt": "Unsubscribe me from the hardware-deals newsletter and confirm it went through.", "expect": {"required": ["route", "confidence"], "values": {"route": "email"}, "types": {"confidence": "number"}, "enum": {"route": ["email", "code", "calendar", "search", "notes"]}}}
{"id": "json-002", "kind": "json", "tags": ["json", "extraction"], "system": "Respond with ONLY a JSON object, no prose.", "prompt": "Convert to JSON with keys \"name\" (string) and \"age\" (integer): \"Priya is 34 and runs the observability team.\"", "expect": {"required": ["name", "age"], "values": {"name": "Priya", "age": 34}, "types": {"age": "integer"}}}
{"id": "json-003", "kind": "json", "tags": ["json"], "system": "Respond with ONLY a JSON object, no prose, with keys \"action\" (one of \"schedule\"|\"cancel\"|\"move\") and \"date\" (YYYY-MM-DD).", "prompt": "Put the team sync on the calendar for July 20, 2026.", "expect": {"required": ["action", "date"], "values": {"action": "schedule", "date": "2026-07-20"}, "enum": {"action": ["schedule", "cancel", "move"]}}}
{"id": "json-004", "kind": "json", "tags": ["json"], "system": "Respond with ONLY a JSON object, no prose: {\"sentiment\": one of \"positive\"|\"negative\"|\"neutral\"}", "prompt": "Classify: \"Third replacement unit and it still overheats within an hour. I'm done with this brand.\"", "expect": {"required": ["sentiment"], "values": {"sentiment": "negative"}, "enum": {"sentiment": ["positive", "negative", "neutral"]}}}
{"id": "json-005", "kind": "json", "tags": ["json", "extraction"], "system": "Respond with ONLY a JSON object, no prose.", "prompt": "Return JSON {\"items\": [...]} listing each piece of hardware mentioned: \"the rack currently holds two GPUs, a managed switch, and a UPS.\"", "expect": {"required": ["items"], "types": {"items": "array"}}}
#
# -- closed QA (verifiable answers) ------------------------------------------
{"id": "qa-001", "kind": "contains", "tags": ["qa"], "system": "Answer concisely.", "prompt": "What is the capital city of Australia?", "expect": {"value": "canberra"}}
{"id": "qa-002", "kind": "numeric", "tags": ["qa"], "system": "Answer with only the number.", "prompt": "What is 17 multiplied by 23?", "expect": {"value": 391, "tol": 0}}
{"id": "qa-003", "kind": "numeric", "tags": ["qa"], "system": "Answer with only the number.", "prompt": "How many kilometers is 5 miles? Round to two decimal places.", "expect": {"value": 8.05, "rel_tol": 0.02}}
{"id": "qa-004", "kind": "regex", "tags": ["qa"], "system": "Answer concisely.", "prompt": "What is the chemical symbol for tin?", "expect": {"pattern": "\\bSn\\b", "ignore_case": true, "sample_pass": "Sn"}}
{"id": "qa-005", "kind": "numeric", "tags": ["qa"], "system": "Answer with only the year.", "prompt": "In what year did the Berlin Wall fall?", "expect": {"value": 1989, "tol": 0}}
