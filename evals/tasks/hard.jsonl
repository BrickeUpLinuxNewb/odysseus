# Project Inari HARD task set: designed to have headroom for a strong 12B,
# so BETTER is reachable and the SWT loop has real mistakes to catch.
# HYPOTHESIS, not proven-hard: validate by baselining gemma3:12b on it.
# Lint after edits: python -m evals run --tasks evals/tasks/hard.jsonl --target selftest --label lint
{"id": "hard-math-001", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "A tank holds 240 liters and is 3/8 full. You add 45 liters, then drain 20% of what is now in the tank. How many liters remain?", "expect": {"value": 108, "tol": 0.5}}
{"id": "hard-math-002", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "Train A departs a station at 2:00 PM at 60 mph. Train B departs the same station at 2:30 PM on the same track at 80 mph in the same direction. How many minutes after Train B departs does it catch up to Train A?", "expect": {"value": 90, "tol": 0.5}}
{"id": "hard-math-003", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "A shirt costs $80. The price is marked up 25%, then that price is discounted 30%, then 8% sales tax is added. What is the final price in dollars, to the cent?", "expect": {"value": 75.6, "tol": 0.02}}
{"id": "hard-math-004", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "A bag has 3 red, 5 blue, and 2 green marbles. You draw two without replacement. What is the probability both are blue, as a percentage rounded to one decimal place?", "expect": {"value": 22.2, "tol": 0.15}}
{"id": "hard-math-005", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "Sarah is 4 times as old as Tom. In 6 years, Sarah will be twice as old as Tom. How old is Tom now?", "expect": {"value": 3, "tol": 0}}
{"id": "hard-math-006", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "A rectangle's length is 3 more than twice its width. Its perimeter is 36. What is its area?", "expect": {"value": 65, "tol": 0}}
{"id": "hard-math-007", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "Consider the sequence 2, 6, 12, 20, 30, ... What is the 8th term?", "expect": {"value": 72, "tol": 0}}
{"id": "hard-math-008", "kind": "numeric", "tags": ["math"], "system": "Solve carefully. Answer with only the final number.", "prompt": "If 5 machines take 5 minutes to make 5 widgets, how many minutes do 100 machines take to make 100 widgets?", "expect": {"value": 5, "tol": 0}}
{"id": "hard-ext-001", "kind": "contains", "tags": ["extraction"], "system": "Answer with only the requested value.", "prompt": "Text: 'The launch was set for March 3. It was later moved to March 10, and finalized for March 17, 2026.' Give the final launch date as YYYY-MM-DD.", "expect": {"value": "2026-03-17"}}
{"id": "hard-ext-002", "kind": "numeric", "tags": ["extraction"], "system": "Answer with only the number.", "prompt": "Text: 'Invoice total is $450. Correction: the total should read $540 after the shipping fix.' What is the correct total? Answer with only the number.", "expect": {"value": 540, "tol": 0}}
{"id": "hard-ext-003", "kind": "exact", "tags": ["extraction"], "system": "Answer with only the requested value.", "prompt": "Text: 'Your order shipped. Ref: ORD-77410. A previous order, ORD-10022, was cancelled last week.' Give the reference code for the order that SHIPPED.", "expect": {"value": "ORD-77410"}}
{"id": "hard-ext-004", "kind": "exact", "tags": ["extraction"], "system": "Follow the requested format exactly.", "prompt": "On the team, everyone received a year-end bonus except Dana and Raj. List the names of everyone who did NOT get a bonus, alphabetically, comma-separated, lowercase.", "expect": {"value": "dana, raj"}}
{"id": "hard-ext-005", "kind": "numeric", "tags": ["extraction"], "system": "Answer with only the number.", "prompt": "Text: 'Shift A had 12 staff, Shift B had 9, Shift C had 15. Two people from Shift C moved to Shift A.' After the move, how many staff are on Shift A? Answer with only the number.", "expect": {"value": 14, "tol": 0}}
{"id": "hard-fmt-001", "kind": "regex", "tags": ["format"], "system": "Output only the username, nothing else.", "prompt": "Create a username from the name 'Grace Hopper': all lowercase, exactly 6 characters, letters only, containing NO vowels (a, e, i, o, u). Output only the username.", "expect": {"pattern": "^[bcdfghjklmnpqrstvwxyz]{6}$", "full": true, "sample_pass": "grchpp"}}
{"id": "hard-fmt-002", "kind": "exact", "tags": ["format"], "system": "Output only the result.", "prompt": "Reverse the letters of the word 'stressed' and output only the result.", "expect": {"value": "desserts"}}
{"id": "hard-fmt-003", "kind": "exact", "tags": ["format"], "system": "Output only the formatted number.", "prompt": "Format the local number '5550172' with area code 415 as (AAA) NNN-NNNN. Output only the formatted number.", "expect": {"value": "(415) 555-0172"}}
{"id": "hard-fmt-004", "kind": "json", "tags": ["json"], "system": "Respond with ONLY a JSON object.", "prompt": "Extract to JSON with keys name (string), age (integer), city (string): 'Dr. Amara Osei, 41, relocated from Accra to Toronto last spring.' The city should be where she lives now.", "expect": {"required": ["name", "age", "city"], "values": {"age": 41, "city": "Toronto"}, "types": {"age": "integer", "name": "string"}}}
{"id": "hard-fmt-005", "kind": "json", "tags": ["json"], "system": "Respond with ONLY a JSON object.", "prompt": "A loan applicant is eligible ONLY IF income > 50000 AND credit_score >= 650. Applicant: income 60000, credit_score 620. Respond with ONLY JSON: {\"eligible\": boolean, \"reason\": string}.", "expect": {"required": ["eligible", "reason"], "values": {"eligible": false}, "types": {"eligible": "boolean", "reason": "string"}}}
{"id": "hard-abs-001", "kind": "contains", "tags": ["abstention"], "system": "Answer using ONLY the text. If the text does not contain the answer, reply with exactly: NOT STATED", "prompt": "Text: 'Acme Corp makes widgets and employs 200 people in Denver.' In what year was Acme Corp founded?", "expect": {"value": "not stated"}}
{"id": "hard-abs-002", "kind": "contains", "tags": ["abstention"], "system": "Answer using ONLY the text. If the text does not contain the answer, reply with exactly: NOT STATED", "prompt": "Text: 'The package weighs 5 kg and ships on Tuesday.' What is the shipping cost?", "expect": {"value": "not stated"}}
{"id": "hard-abs-003", "kind": "contains", "tags": ["abstention"], "system": "Answer using ONLY the memo. If it cannot be determined from the memo, reply with exactly: CANNOT DETERMINE", "prompt": "Memo: 'The CEO drives a blue sedan.' What color is the CEO's third car?", "expect": {"value": "cannot determine"}}
{"id": "hard-log-001", "kind": "choice", "tags": ["logic"], "system": "Answer with exactly one word: yes or no.", "prompt": "All bloops are razzies. No razzies are lazzies. Can a bloop be a lazzie? Answer yes or no.", "expect": {"choices": ["yes", "no"], "answer": "no"}}
{"id": "hard-log-002", "kind": "exact", "tags": ["logic"], "system": "Answer with only the name.", "prompt": "Four runners finished a race. Dana finished ahead of Priya. Kwame finished after Priya. Liu finished ahead of Dana. Who finished last? Answer with the one name.", "expect": {"value": "kwame"}}
{"id": "hard-log-003", "kind": "contains", "tags": ["logic"], "system": "Answer in one or two words.", "prompt": "A is B's father. C is A's sister. How is C related to B? Answer in one or two words.", "expect": {"value": "aunt"}}
{"id": "hard-log-004", "kind": "choice", "tags": ["logic"], "system": "Answer with exactly one letter.", "prompt": "A is taller than B. C is shorter than B. D is taller than A. Who is the shortest? Answer with one letter: A, B, C, or D.", "expect": {"choices": ["a", "b", "c", "d"], "answer": "c"}}
